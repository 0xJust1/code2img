{
  "name": "code2img-mcp",
  "version": "0.1.1",
  "description": "Model Context Protocol server for Code2Img: render code screenshots from Claude Desktop, Cursor, VS Code or Windsurf (stdio), or call the hosted server at https://code2img.app/mcp.",
  "license": "MIT",
  "author": "Justin <hello@code2img.app> (https://github.com/0xJust1)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xJust1/code2img.git"
  },
  "homepage": "https://code2img.app/mcp",
  "bugs": {
    "url": "https://github.com/0xJust1/code2img/issues"
  },
  "keywords": [
    "code",
    "screenshot",
    "mcp",
    "model-context-protocol",
    "image",
    "render",
    "syntax-highlighting"
  ],
  "type": "module",
  "bin": {
    "code2img-mcp": "./dist/stdio.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http": {
      "types": "./dist/http.d.ts",
      "default": "./dist/http.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}