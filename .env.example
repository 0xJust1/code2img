# ---- apps/web (Next.js, port 3335 en prod) ----
APP_URL=http://localhost:3335
# Proxy render (service natif systemd code2img-render sur 1.45)
RENDER_URL=http://127.0.0.1:3002

# ---- apps/render ----
PORT=3002
REDIS_URL=
SELF_ORIGIN=http://127.0.0.1:3002

# ---- Postgres natif (sur 1.45 — procédure dans le README) ----
DATABASE_URL=postgres://code2img:CHANGE_ME@127.0.0.1:5432/code2img

# ---- Rate limiting API (Phase 4) ----
# Redis natif sur 1.45 (127.0.0.1:6379). Vide = compteurs en mémoire du process web
# (dev/tests uniquement : remis à zéro à chaque redémarrage).
REDIS_URL=redis://127.0.0.1:6379
# Signature des URLs /api/v1/render.png (openssl rand -base64 32). Vide = endpoint 503.
RENDER_SIGN_SECRET=CHANGE_ME

# ---- Auth (Better Auth) ----
# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME
# Magic links sans SMTP -> imprimés dans les logs du service (dev/test seulement).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Code2Img <no-reply@code2img.app>"
# OAuth : désactivé sauf si les deux vars sont définies.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Trust boundary render ----
# Le web marque les requêtes Pro (sans watermark, 4x, uploads) avec ce token.
RENDER_INTERNAL_TOKEN=CHANGE_ME
UPLOADS_DIR=/home/justin/code2img/code2img/apps/web/data/uploads
# Images des liens publics /i/[slug] (disque v1 ; R2/S3 = remplacer src/lib/storage.ts).
SHARE_IMAGES_DIR=/home/justin/code2img/code2img/apps/web/data/share

# ---- Stripe — TEST MODE UNIQUEMENT (live = go humain) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_PRO_MONTHLY=price_xxx_monthly   # 7 €/mois
STRIPE_PRICE_PRO_YEARLY=price_xxx_yearly     # 59 €/an
# Add-on API 29 €/mois -> Phase 4 (STRIPE_PRICE_API_ADDON)

# ---- Pricing (affichage, 100% env) ----
PRICE_PRO_MONTHLY_EUR=7
PRICE_PRO_YEARLY_EUR=59
PRICE_API_ADDON_MONTHLY_EUR=29
