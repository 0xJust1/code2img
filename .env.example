# ---- apps/web (Next.js) ----
# Where the web app proxies /api/render (docker service name or localhost in dev)
RENDER_URL=http://localhost:3002

# ---- apps/render ----
PORT=3002
# Leave empty to render inline (dev without Redis); set to enable the BullMQ queue.
REDIS_URL=
# Optional override of the self-origin used for self-hosted fonts in the render browser
SELF_ORIGIN=http://127.0.0.1:3002
# Watermark removal is a paid entitlement (Phase 2). Keep "true" until then.
ENFORCE_WATERMARK=true

# ---- Phase 2: Postgres (Drizzle + Better Auth) ----
DATABASE_URL=postgres://code2img:change-me@postgres:5432/code2img

# ---- Phase 2: pricing (100% env-driven) ----
PRICE_PRO_MONTHLY_EUR=7
PRICE_PRO_YEARLY_EUR=59
PRICE_API_ADDON_MONTHLY_EUR=29
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_API_ADDON=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
