{
  "name": "code2img",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@9.15.9",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' dev",
    "build": "pnpm --filter code2img-mcp build && pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @code2img/web e2e",
    "pack:mcp": "pnpm --filter code2img-mcp build && cd packages/mcp && npm pack --silent && cp code2img-mcp-*.tgz ../../apps/web/public/downloads/code2img-mcp.tgz"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
